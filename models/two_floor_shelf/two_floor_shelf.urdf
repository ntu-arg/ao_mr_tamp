<?xml version="1.0"?>
<robot name="two_floor_shelf">
  <!-- Outer dimensions: width=0.31, depth=0.18, height=0.42 -->

  <material name="WoodLight">
    <color rgba="0.72 0.53 0.34 1.0"/>
  </material>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>
  </link>

  <!-- Bottom panel -->
  <link name="bottom_panel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.31 0.18 0.01"/></geometry>
      <material name="WoodLight"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.31 0.18 0.01"/></geometry>
    </collision>
  </link>
  <joint name="bottom_panel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="bottom_panel"/>
    <origin xyz="0 0 0.005" rpy="0 0 0"/>
  </joint>

  <!-- Top panel -->
  <link name="top_panel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.31 0.18 0.01"/></geometry>
      <material name="WoodLight"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.31 0.18 0.01"/></geometry>
    </collision>
  </link>
  <joint name="top_panel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="top_panel"/>
    <origin xyz="0 0 0.415" rpy="0 0 0"/>
  </joint>

  <!-- Middle divider (creates two floors) -->
  <link name="middle_panel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.31 0.18 0.01"/></geometry>
      <material name="WoodLight"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.31 0.18 0.01"/></geometry>
    </collision>
  </link>
  <joint name="middle_panel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="middle_panel"/>
    <origin xyz="0 0 0.21" rpy="0 0 0"/>
  </joint>

  <!-- Corner struts -->
  <link name="front_left_strut">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="5e-4" ixy="0" ixz="0" iyy="5e-4" iyz="0" izz="5e-4"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.01 0.01 0.42"/></geometry>
      <material name="WoodLight"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.01 0.01 0.42"/></geometry>
    </collision>
  </link>
  <joint name="front_left_strut_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_left_strut"/>
    <origin xyz="-0.15 0.085 0.21" rpy="0 0 0"/>
  </joint>

  <link name="front_right_strut">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="5e-4" ixy="0" ixz="0" iyy="5e-4" iyz="0" izz="5e-4"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.01 0.01 0.42"/></geometry>
      <material name="WoodLight"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.01 0.01 0.42"/></geometry>
    </collision>
  </link>
  <joint name="front_right_strut_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_right_strut"/>
    <origin xyz="0.15 0.085 0.21" rpy="0 0 0"/>
  </joint>

  <link name="back_left_strut">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="5e-4" ixy="0" ixz="0" iyy="5e-4" iyz="0" izz="5e-4"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.01 0.01 0.42"/></geometry>
      <material name="WoodLight"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.01 0.01 0.42"/></geometry>
    </collision>
  </link>
  <joint name="back_left_strut_joint" type="fixed">
    <parent link="base_link"/>
    <child link="back_left_strut"/>
    <origin xyz="-0.15 -0.085 0.21" rpy="0 0 0"/>
  </joint>

  <link name="back_right_strut">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="5e-4" ixy="0" ixz="0" iyy="5e-4" iyz="0" izz="5e-4"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.01 0.01 0.42"/></geometry>
      <material name="WoodLight"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.01 0.01 0.42"/></geometry>
    </collision>
  </link>
  <joint name="back_right_strut_joint" type="fixed">
    <parent link="base_link"/>
    <child link="back_right_strut"/>
    <origin xyz="0.15 -0.085 0.21" rpy="0 0 0"/>
  </joint>

</robot>
