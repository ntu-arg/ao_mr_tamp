<?xml version="1.0"?>
<robot name="big_table">
  <!-- Outer dimensions: width=3.20, depth=1.60, height=0.88 -->

  <material name="TableTop">
    <color rgba="0.60 0.45 0.30 1.0"/>
  </material>
  <material name="TableLeg">
    <color rgba="0.20 0.20 0.20 1.0"/>
  </material>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>
  </link>

  <link name="tabletop">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="40.0"/>
      <inertia ixx="8.5387" ixy="0" ixz="0" iyy="34.1387" iyz="0" izz="42.6667"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="3.20 1.60 0.04"/></geometry>
      <material name="TableTop"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="3.20 1.60 0.04"/></geometry>
    </collision>
  </link>
  <joint name="tabletop_joint" type="fixed">
    <parent link="base_link"/><child link="tabletop"/>
    <origin xyz="0 0 0.86" rpy="0 0 0"/>
  </joint>

  <link name="leg_fl">
    <inertial><origin xyz="0 0 0"/><mass value="2.0"/><inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/></inertial>
    <visual><geometry><box size="0.05 0.05 0.84"/></geometry><material name="TableLeg"/></visual>
    <collision><geometry><box size="0.05 0.05 0.84"/></geometry></collision>
  </link>
  <joint name="leg_fl_joint" type="fixed"><parent link="base_link"/><child link="leg_fl"/><origin xyz="1.575 0.775 0.42"/></joint>

  <link name="leg_fr">
    <inertial><origin xyz="0 0 0"/><mass value="2.0"/><inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/></inertial>
    <visual><geometry><box size="0.05 0.05 0.84"/></geometry><material name="TableLeg"/></visual>
    <collision><geometry><box size="0.05 0.05 0.84"/></geometry></collision>
  </link>
  <joint name="leg_fr_joint" type="fixed"><parent link="base_link"/><child link="leg_fr"/><origin xyz="1.575 -0.775 0.42"/></joint>

  <link name="leg_rl">
    <inertial><origin xyz="0 0 0"/><mass value="2.0"/><inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/></inertial>
    <visual><geometry><box size="0.05 0.05 0.84"/></geometry><material name="TableLeg"/></visual>
    <collision><geometry><box size="0.05 0.05 0.84"/></geometry></collision>
  </link>
  <joint name="leg_rl_joint" type="fixed"><parent link="base_link"/><child link="leg_rl"/><origin xyz="-1.575 0.775 0.42"/></joint>

  <link name="leg_rr">
    <inertial><origin xyz="0 0 0"/><mass value="2.0"/><inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/></inertial>
    <visual><geometry><box size="0.05 0.05 0.84"/></geometry><material name="TableLeg"/></visual>
    <collision><geometry><box size="0.05 0.05 0.84"/></geometry></collision>
  </link>
  <joint name="leg_rr_joint" type="fixed"><parent link="base_link"/><child link="leg_rr"/><origin xyz="-1.575 -0.775 0.42"/></joint>
</robot>
