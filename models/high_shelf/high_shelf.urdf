<?xml version="1.0"?>
<robot name="high_shelf">
  <!-- Outer size target: width=0.60, depth=0.27, height=1.40 -->

  <material name="ShelfMetalLight">
    <color rgba="0.72 0.72 0.72 1.0"/>
  </material>

  <material name="ShelfMetalDark">
    <color rgba="0.35 0.35 0.35 1.0"/>
  </material>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>
  </link>

  <!-- Shelf board 1 -->
  <link name="shelf_1">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.2"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.60 0.27 0.015"/></geometry>
      <material name="ShelfMetalLight"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.60 0.27 0.015"/></geometry>
    </collision>
  </link>
  <joint name="shelf_1_joint" type="fixed">
    <parent link="base_link"/>
    <child link="shelf_1"/>
    <origin xyz="0 0 0.0375" rpy="0 0 0"/>
  </joint>

  <!-- Shelf board 2 -->
  <link name="shelf_2">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.2"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.60 0.27 0.015"/></geometry>
      <material name="ShelfMetalLight"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.60 0.27 0.015"/></geometry>
    </collision>
  </link>
  <joint name="shelf_2_joint" type="fixed">
    <parent link="base_link"/>
    <child link="shelf_2"/>
    <origin xyz="0 0 0.4875" rpy="0 0 0"/>
  </joint>

  <!-- Shelf board 3 -->
  <link name="shelf_3">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.2"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.60 0.27 0.015"/></geometry>
      <material name="ShelfMetalLight"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.60 0.27 0.015"/></geometry>
    </collision>
  </link>
  <joint name="shelf_3_joint" type="fixed">
    <parent link="base_link"/>
    <child link="shelf_3"/>
    <origin xyz="0 0 0.9375" rpy="0 0 0"/>
  </joint>

  <!-- Shelf board 4 (top) -->
  <link name="shelf_4">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.2"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.60 0.27 0.015"/></geometry>
      <material name="ShelfMetalLight"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.60 0.27 0.015"/></geometry>
    </collision>
  </link>
  <joint name="shelf_4_joint" type="fixed">
    <parent link="base_link"/>
    <child link="shelf_4"/>
    <origin xyz="0 0 1.3925" rpy="0 0 0"/>
  </joint>

  <!-- Legs -->
  <link name="leg_fl">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.8"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.02 0.02 1.40"/></geometry>
      <material name="ShelfMetalDark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.02 0.02 1.40"/></geometry>
    </collision>
  </link>
  <joint name="leg_fl_joint" type="fixed">
    <parent link="base_link"/>
    <child link="leg_fl"/>
    <origin xyz="0.29 0.125 0.70" rpy="0 0 0"/>
  </joint>

  <link name="leg_fr">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.8"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.02 0.02 1.40"/></geometry>
      <material name="ShelfMetalDark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.02 0.02 1.40"/></geometry>
    </collision>
  </link>
  <joint name="leg_fr_joint" type="fixed">
    <parent link="base_link"/>
    <child link="leg_fr"/>
    <origin xyz="0.29 -0.125 0.70" rpy="0 0 0"/>
  </joint>

  <link name="leg_rl">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.8"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.02 0.02 1.40"/></geometry>
      <material name="ShelfMetalDark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.02 0.02 1.40"/></geometry>
    </collision>
  </link>
  <joint name="leg_rl_joint" type="fixed">
    <parent link="base_link"/>
    <child link="leg_rl"/>
    <origin xyz="-0.29 0.125 0.70" rpy="0 0 0"/>
  </joint>

  <link name="leg_rr">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.8"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.02 0.02 1.40"/></geometry>
      <material name="ShelfMetalDark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.02 0.02 1.40"/></geometry>
    </collision>
  </link>
  <joint name="leg_rr_joint" type="fixed">
    <parent link="base_link"/>
    <child link="leg_rr"/>
    <origin xyz="-0.29 -0.125 0.70" rpy="0 0 0"/>
  </joint>

</robot>
