<?xml version="1.0"?>
<sdf version="1.6">
  <model name="wooden_box">
    <static>true</static>
    <link name="base_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>1e-4</ixx>
          <iyy>1e-4</iyy>
          <izz>1e-4</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
    </link>

    <material>
      <script>
        <uri>file://media/materials/scripts/gazebo.material</uri>
        <name>Gazebo/Wood</name>
      </script>
    </material>

    <link name="bottom_panel">
      <pose>0 0 0.005 0 0 0</pose>
      <collision name="bottom_collision">
        <geometry><box><size>0.25 0.35 0.01</size></box></geometry>
      </collision>
      <visual name="bottom_visual">
        <geometry><box><size>0.25 0.35 0.01</size></box></geometry>
        <material><ambient>0.72 0.53 0.34 1</ambient><diffuse>0.72 0.53 0.34 1</diffuse></material>
      </visual>
    </link>
    <joint name="bottom_panel_joint" type="fixed">
      <parent>base_link</parent>
      <child>bottom_panel</child>
      <pose>0 0 0.005 0 0 0</pose>
    </joint>

    <link name="left_panel">
      <pose>-0.12 0 0.10 0 0 0</pose>
      <collision name="left_collision">
        <geometry><box><size>0.01 0.35 0.20</size></box></geometry>
      </collision>
      <visual name="left_visual">
        <geometry><box><size>0.01 0.35 0.20</size></box></geometry>
        <material><ambient>0.72 0.53 0.34 1</ambient><diffuse>0.72 0.53 0.34 1</diffuse></material>
      </visual>
    </link>
    <joint name="left_panel_joint" type="fixed">
      <parent>base_link</parent>
      <child>left_panel</child>
      <pose>-0.12 0 0.10 0 0 0</pose>
    </joint>

    <link name="right_panel">
      <pose>0.12 0 0.10 0 0 0</pose>
      <collision name="right_collision">
        <geometry><box><size>0.01 0.35 0.20</size></box></geometry>
      </collision>
      <visual name="right_visual">
        <geometry><box><size>0.01 0.35 0.20</size></box></geometry>
        <material><ambient>0.72 0.53 0.34 1</ambient><diffuse>0.72 0.53 0.34 1</diffuse></material>
      </visual>
    </link>
    <joint name="right_panel_joint" type="fixed">
      <parent>base_link</parent>
      <child>right_panel</child>
      <pose>0.12 0 0.10 0 0 0</pose>
    </joint>

    <link name="front_panel">
      <pose>0 0.17 0.10 0 0 0</pose>
      <collision name="front_collision">
        <geometry><box><size>0.25 0.01 0.20</size></box></geometry>
      </collision>
      <visual name="front_visual">
        <geometry><box><size>0.25 0.01 0.20</size></box></geometry>
        <material><ambient>0.72 0.53 0.34 1</ambient><diffuse>0.72 0.53 0.34 1</diffuse></material>
      </visual>
    </link>
    <joint name="front_panel_joint" type="fixed">
      <parent>base_link</parent>
      <child>front_panel</child>
      <pose>0 0.17 0.10 0 0 0</pose>
    </joint>

    <link name="back_panel">
      <pose>0 -0.17 0.10 0 0 0</pose>
